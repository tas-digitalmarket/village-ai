# OpenRouter API Key - Get from https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional alternative provider. If OPENROUTER_API_KEY is empty, SambaNova will be used.
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Optional. Only debug endpoints use this when DEBUG_ENABLED=true.
CREATOR_TOKEN=

# Enable debug endpoints only when needed
DEBUG_ENABLED=false

# Optional model overrides
PRIMARY_MODEL=openai/gpt-oss-20b:free
FALLBACK_MODEL=meta-llama/llama-3.2-3b-instruct:free
SAMBANOVA_PRIMARY_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_FALLBACK_MODEL=DeepSeek-V3.1

# Server Port (default: 3000)
PORT=3000

# Tick interval in minutes (default: 5)
TICK_INTERVAL=5
